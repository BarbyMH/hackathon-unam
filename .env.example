# Copia este archivo como .env (no se versiona y NO se incluye en el .zip de entrega).

# --- Llaves temporales del workshop (solo si usas Bedrock; esta app no lo necesita) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Plataforma GRIDIRON MX ---
# Secreto para firmar los JWT. Si se deja vacío se genera uno al arrancar (las sesiones se pierden al reiniciar).
JWT_SECRET=
# 1 = cookies solo por HTTPS (recomendado). Pon 0 si tu navegador no guarda la sesión en http://localhost (p. ej. Safari).
COOKIE_SECURE=1
# 1 = modo demostración: cuentas de prueba y códigos de verificación/2FA visibles en pantalla. Pon 0 en un entorno real.
DEMO_MODE=1

# Primer superadmin (se crea al arrancar). El secreto TOTP es base32; si se deja vacío se genera uno aleatorio.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Archivo o carpeta de datos (relativo a la raíz del proyecto). Vacío = detectar todo lo que haya en /data.
DATA_FILE_PATH=
# 0 = no consultar fuentes externas (ESPN). La app funciona igual con el archivo local.
EXTERNAL_SOURCES=1
